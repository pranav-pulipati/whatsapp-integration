# Copy to .env and fill in. NEVER commit .env.
# Per-number 360dialog API keys are NOT set here: they are entered when a number
# is onboarded (dashboard → Accounts, or `python -m app.cli add-account`) and stored
# encrypted in the database.

APP_ENV=development            # development | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://wa:wa@localhost:5432/wa_dashboard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Dashboard auth --------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-random-48+-char-string>
JWT_EXPIRES_MINUTES=480
# Comma-separated. Only needed if the dashboard is served from a different origin.
CORS_ORIGINS=http://localhost:5173

# Fernet key encrypting provider API keys at rest.
# Generate: cd backend && uv run python -m app.cli gen-key
ENCRYPTION_KEY=<generate-with-app.cli-gen-key>

# --- Webhooks --------------------------------------------------------------
# Public HTTPS base URL of this service (used to build each number's webhook URL).
PUBLIC_BASE_URL=https://<your-domain>
# Sent by 360dialog as a custom header on every webhook (configured automatically
# by `register-webhook`). Generate like JWT_SECRET.
WEBHOOK_SHARED_SECRET=<generate-a-random-32+-char-string>
WEBHOOK_SECRET_HEADER=X-Webhook-Secret

# --- 360dialog -------------------------------------------------------------
DIALOG360_API_BASE_URL=https://waba-v2.360dialog.io
# Sandbox: https://waba-sandbox.360dialog.io
# Optional HMAC verification of x-360dialog-signature (partner platform secret).
DIALOG360_PLATFORM_SECRET=
DIALOG360_REQUIRE_SIGNATURE=false

# --- Media storage (S3-compatible) -----------------------------------------
# Local MinIO from docker-compose. In production use S3 / R2 / etc. and leave
# S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wa-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Set to AES256 on AWS S3 to request server-side encryption.
S3_SERVER_SIDE_ENCRYPTION=

# --- Processing / analytics ------------------------------------------------
EVENT_MAX_ATTEMPTS=8
MEDIA_MAX_ATTEMPTS=5
RAW_EVENT_RETENTION_DAYS=30
ACTIVE_CONVERSATION_HOURS=24
